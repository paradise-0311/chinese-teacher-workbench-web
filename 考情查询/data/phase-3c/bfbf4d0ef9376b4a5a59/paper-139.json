165]"},"basis":"原卷按该书内容设题"}]]},"comparison_groups":{"kind":"array","entries":[[24,{"paper_id":"八上|25-81-F","occurrence_ids":[{"$kq":18},{"$kq":20}],"question_ids":[{"$kq":6}]}],[25,{"paper_id":"八上|25-81-F","occurrence_ids":[{"$kq":22},{"$kq":24}],"question_ids":[{"$kq":8}]}]]}},"KQ_STAGE_CHART_EVIDENCE":{"literary_theme_records":{"kind":"array","entries":[[129,{"paper_id":"八上|25-81-F","title":"父亲和树","identity":"八上|25-81-F|work_5668074796c1e16846556909","main_theme":"亲情家庭","secondary_theme":null,"unit_ids":["unit:八上|25-81-F|6"],"occurrence_ids":[{"$kq":27}],"source":{"path":{"$kq":2},"anchor":"[[118, 134]]","basis":"以父亲与果树的一生写亲情和后辈的理解。"},"type_sources":[]}]]},"inclass_reading_records":{"kind":"array","entries":[[190,{"occurrence_id":{"$kq":18},"paper_id":"八上|25-81-F","work_id":{"$kq":19},"title":"《雁门太守行》","block":1,"unit_ids":["unit:八上|25-81-F|3"],"inclass":"课内","method":"以原卷正文对照同期教材","proof":[{"type":"以原卷正文对照同期教材","catalog":"人教版《语文》八上（2025年秋版）","section":"第六单元《诗词五首》"}],"material_source":{"path":{"$kq":2},"anchor":"[[36, 40]]"},"textbook_version_basis":"人教版《语文》八上（2025年秋版）"}],[191,{"occurrence_id":{"$kq":22},"paper_id":"八上|25-81-F","work_id":{"$kq":23},"title":"《生于忧患，死于安乐》","block":2,"unit_ids":["unit:八上|25-81-F|4"],"inclass":"课内","method":"以原卷正文对照同期教材","proof":[{"type":"以原卷正文对照同期教材","catalog":"人教版《语文》八上（2025年秋版）","section":"第六单元《〈孟子〉三章》"}],"material_source":{"path":{"$kq":2},"anchor":"[[56, 59]]"},"textbook_version_basis":"人教版《语文》八上（2025年秋版）"}]]}},"KQ_READING_POLICY":{"curriculum_scopes":{"kind":"object","entries":[[192,{"$kq":18},{"scope":"current_book","book":"八上","label":"本册教材 · 八上","proof":{"type":"以原卷正文对照同期教材","catalog":"人教版《语文》八上（2025年秋版）","section":"第六单元《诗词五首》"}}],[193,{"$kq":22},{"scope":"current_book","book":"八上","label":"本册教材 · 八上","proof":{"type":"以原卷正文对照同期教材","catalog":"人教版《语文》八上（2025年秋版）","section":"第六单元《〈孟子〉三章》"}}]]}}},"details":[],"paperSearch":[]},"encoding":"string-pool-1","pool":["incq_f0060d43caf6d9e535d7dc32","1．近日，河北博物院“光耀千年——中国古代灯具文化展”开展了，育才中学八（1）班拟开展“探寻千年灯火，感悟匠人情怀”主题学习活动，请你协助完成以下任务。\n【宣传推介】\n（1）下面是小冀同学为活动写的推介语，请你完成相关内容。\n千年灯火，光耀中华。A河北博物院在本次展览中，展出了从战国至明清以来大约百余件灯具珍品。一件件（gǔ  pǔ）的灯具在展馆中静驻时光。战国青铜灯造型别致，汉代陶俑灯人   （甲）   （惟妙惟肖/入木三分），B它们曾以微弱光芒对抗漫漫长夜，那份倔强至今令人动容。尤其巧妙的是那些   （乙）   （别开生面/独具匠心）的设计□如长信宫灯将烟尘收纳于宫女袖管，体现着超前的智慧。这些凝聚着匠心与审美的器物，历来受到文人雅士的（tuī  chóng）。然而岁月侵蚀，许多珍贵技艺曾濒临失传。今日我们凝望这些灯火，不仅为感受光明，更为守护那不曾熄灭的文明薪火。\n①给文段中加点的词语注音，并根据拼音写汉字。\ngǔ  pǔ（ 　　　 ）    tuī  chóng（ 　　　 ）    倔强（ 　　　 ）    濒临（ 　　　 ）\n②从文段括号内选择符合语境的词语，分别填入横线处。\n甲：　　　     乙：　　　 \n③在文段□内填入的标点符号最恰当的一项是（ 　　　 ）\nA.，B.；C.——D.。\n④语段中画波浪线的A句是病句，请给出修改意见。\n⑤请提取出文段中画横线B句的主干。\n【拟写邀请函】\n（2）为丰富活动内容，班级准备邀请河北博物院“光耀千年”展览的专业人员来校举办专题讲座，以下是邀请函的内容。\n                                                                      邀请函\n尊敬的河北博物院“光耀千年”展览工作组专家：\n       我校八（1）班正在开展“探寻千年灯火，感悟匠人情怀”主题学习活动。为了让同学们深入了解中国古代灯具文化的深厚底蕴与工艺智慧，我们诚挚邀请贵院展览专家来我校举办专题讲座。如蒙应允，讲座时间拟安排在1月20日下午三时，地点为我校学术报告厅。我们将认真组织，确保讲座顺利进行。请您务必到来，为同学们点亮一盏文化传承的明灯。\n       此致\n敬礼！\n                                                                                                                                  2026年1月13日\n                                                                                                                     育才中学八（1）班班委会\n在这个邀请函中有两处表达不得体，请你找出来并给出修改意见。\n①　　　 \n②　　　 ","assets/updates/20261113_指定学校往年试卷补录/paper_586b0e6be6bb07d81012b8dc/试卷.docx","a27761e2653a2c6a382e462087a05f6f0b08ec5404d778ddf3a571e08d64320b","incq_e200e3d02c140943de463038","2．阅读下面文字，在横线上填写相应的句子。\n河北大地，燕赵风华。行走在这片古老的土地上，每一处遗迹都在低语着千年的故事。探访正定赵云庙，追忆子龙将军一生，正契合孟子提出的“富贵不能淫，①　　　 ，②　　　 ”的大丈夫的坚守。泛舟白洋淀，芦荡浩渺，水天相接，宛如李清照《渔家傲》中瑰丽的梦境“天接云涛连晓雾，③　　　 ”。夜游保定古莲花池畔，月色皎洁、竹影婆娑，恰似《记承天寺夜游》中“④　　　 ，⑤　　　 ，盖竹柏影也”的意境。参观邺城遗址，遥想三国纷争，杜牧的一句“东风不与周郎便，⑥　　　 ”，道尽了历史的偶然与沧桑。山河入卷，岁月成诗。这些镌刻在诗文里的情怀与哲思，正伴着河北大地上的遗迹，在岁月长河中生生不息。","incq_1d9b8a474dd7f4702e24790b","3．阅读古诗，完成下面小题。\n（甲）\n雁门太守行\n李贺\n黑云压城城欲摧，甲光向日金鳞开。角声满天秋色里，塞上燕脂凝夜紫。\n半卷红旗临易水，霜重鼓寒声不起。报君黄金台上意，提携玉龙为君死。\n（乙）\n喜迁莺①（节选）  \n蔡挺\n霜天秋晓，正紫塞故垒，黄云衰草。汉马嘶风，陇上铁衣寒早。\n剑歌骑曲悲壮，尽道君恩须报。塞垣乐，山西年少。\n①喜迁莺：词牌名。\n（1）下列说法不正确的一项是（ 　　　 ）\nA.甲诗“燕脂”“夜紫”指战场血迹，鲜血像夜空、泥土那样变成暗紫色。\nB.甲诗“临易水”反用荆轲刺秦典故，“风萧萧兮”蕴含着怀才不遇之感。\nC.乙词由秋霜起笔，写出了景色的凄清，继而描绘出一幅独特的边塞风貌。\nD.乙词“陇上铁衣寒早”大意是陇山上将士身穿铠甲，在早寒中戍守边疆。\n（2）这两首诗词都表现了边塞将士的一种共同情怀。请简要概括这是一种怎样的情怀，并分别从两首诗中各找出一句最能体现这种情怀的诗句加以分析。","incq_dc8637e0e8ba778e954532d5","4．阅读下面文言文，完成题目。\n【甲】舜发于畎亩之中，傅说举于版筑之间，胶鬲举于鱼盐之中，管夷吾举于士，孙叔敖举于海，百里奚举于市。故天将降大任于是人也，必先苦其心志，劳其筋骨，饿其体肤，空乏其身，行拂乱其所为，所以动心忍性，曾益其所不能。\n人恒过，然后能改；困于心，衡于虑，而后作；征于色，发于声，而后喻。入则无法家拂士，出则无敌国外患者，国恒亡。然后知生于忧患而死于安乐也。\n（选自《生于忧患，死于安乐》）\n【乙】承宫，琅邪姑幕人。少孤，年八岁，为人牧猪。乡里徐子盛明①《春秋》经，授诸生数百人。宫过其庐②下，见诸生讲诵，好之，因忘其猪而听经。猪主怪其不还，寻之。见而欲笞之。门下生③共禁，乃止，因留宫门下。樵薪④执苦，数十年间，遂通其经。\n（节选自《承宫樵薪苦学》）\n【注】①明：懂得；精通。②庐：屋，指书舍。③门下生：指学舍里的学生。④樵薪：砍柴。\n（1）根据语境，参考方法提示，解释文中加点词语的意思。\n加点词语\n方法提示\n解释（填写文字或序号）\n百里奚举于市\n关联成语法：海市蜃楼\n市：_____ \n而后喻\n语境推测法：“征于色，发于声，而后喻。”\n喻：_____ \n乃止\n课内迁移法：亚夫乃传言开壁门\n乃：_____ \n遂通其经\n查阅词典法：遂：①道路。②终于。③于是，就。④通达。\n遂：_____ \n（2）下列句中加点词的意思相同的一项是（ 　　　 ）\nA.见而欲笞之/解衣欲睡（《记承天寺夜游》）\nB.必先苦其心志/樵薪执苦\nC.舜发于畎亩之中/箕畚运于渤海之尾（《愚公移山》）\nD.行拂乱其所为/为人牧猪\n（3）请将下面句子翻译成现代汉语。\n①入则无法家拂士，出则无敌国外患者，国恒亡。\n②宫过其庐下，见诸生讲诵，好之，因忘其猪而听经。\n（4）《孟子》文章以雄辩著称，【甲】文在语言上是如何体现出的？从文中举一个例子做具体分析。\n（5）结合【乙】文内容，简要分析承宫的事例是怎样体现【甲】文“生于忧患”这个观点的。","incq_7f3e679cb030f1a63128ee50","5．阅读下面文字，回答下列问题。\n石家庄抱犊寨：太行深处的奇寨秘境\n①抱犊寨，旧名抱犊山，坐落于河北省石家庄市鹿泉区，距市区仅16公里，是太行山东麓一处集自然风光与人文古迹于一体的名山古寨。它东望平原沃野，西枕太行群峰，海拔580米，四周皆是悬崖峭壁，仅靠一条人工开凿的石阶栈道连通上下，素有“天下奇寨”“抱犊福地”之称。\n②抱犊寨之名，源于一段古老的传说。相传在古代，有一位农夫赶着牛犊上山垦荒，行至山脚下，见山势险峻、无路可通，便将牛犊抱在怀中，奋力攀登，最终登顶安家。后人感念其毅力，便将此山命名为抱犊山。三国时期，这里成为军事要塞，名将赵云曾在此屯兵练兵；到了宋代，义军领袖宋江麾下的好汉也曾在此安营扎寨，抱犊寨的军事地位由此愈发凸显。\n③作为一处融山、水、洞、寺于一体的景区，抱犊寨的自然景观堪称一绝。山顶平旷开阔，方圆600余亩，宛如一座巨大的天然观景台。站立山巅，东可俯瞰石家庄市区的高楼林立、车水马龙、西能远眺太行山脉的层峦叠嶂、云雾缭绕。山中植被茂密，春夏时节，绿树成荫、繁花似锦；深秋之际，红叶似火，层林尽染；隆冬时分，银装素裹，宛如仙境。此外，山中还有诸多天然溶洞，如仙人洞、天门洞等，洞内钟乳石形态各异，栩栩如生，引得无数游客叹为观止。\n④抱犊寨的人文景观同样底蕴深厚。山上的南天门，高13.9米，宽23米，是我国目前最大的山顶门坊式建筑，飞檐翘角，气势恢宏，门楣上“南天门”三个大字苍劲有力，尽显雄奇。始建于唐代的金阙宫，是一座规模宏大的道教宫观，宫内殿宇错落有致，香火绵延不绝，常年有道士在此修行讲经。还有韩信祠、环山长城等古迹，每一处都承载着厚重的历史，诉说着抱犊寨的千年沧桑。\n⑤如今的抱犊寨，早已成为石家庄市民休闲度假的好去处。景区不断完善基础设施，修建了便捷的观光索道，让游客无需费力攀登就能饱览山景；同时推出民俗文化节、登山节等特色活动，将自然风光与民俗风情巧妙融合。这座矗立在太行深处的古寨，正以独特的魅力，吸引着八方来客，成为石家庄一张亮丽的地域文化名片。\n（1）下列对文章内容的理解与分析，不正确的一项是（ 　　　 ）\nA.抱犊寨位于石家庄市鹿泉区，距市区16公里，因古代农夫抱犊登山的传说而得名。\nB.抱犊寨海拔580米，四周悬崖峭壁，仅靠一条人工石阶栈道连通，地势十分险要。\nC.抱犊寨山顶平旷开阔，方圆600余亩，既是天然观景台，也是历史上重要的军事要塞。\nD.金阙宫是抱犊寨规模最大的建筑，始建于唐代，是一座香火旺盛的佛教寺庙。\n（2）本文的说明对象是什么？文章是从哪三个方面对其进行介绍的？\n（3）文章第三段中划线句子采用了哪种说明方法，并分析其作用。\n（4）结合全文，说说抱犊寨为什么能成为“石家庄一张亮丽的地域文化名片”？","incq_0ca2c799b7ded988d1b1295b","6．阅读下面文字，回答下列问题。\n父亲和树\n①现在，这些苹果树老了，老了的苹果树结不了多少果子，也结不出品相端庄的好果子，觉得没脸活了。它们把池里的肥力吃了太多，根又粗又大，却无法顺应自己的愿望就此倒下。风也懒得理会它们，绕着吹。\n②只有父亲理解这些老了的苹果树的心思，他提着斧头进了果园。\n③这一片苹果树跟父亲打了三十年交道，它们经历了父亲的中年和老年，父亲经历了它们的一生。它们了解父亲，就如父亲对它们目前所思所想的洞察。\n④父亲在动手之前，用手量了这棵苹果树的树干，四拃多一点。父亲知道，它的身体里藏着30个年轮。也就是说，上世纪80年代末，它还是一株小树苗，嫩叶在阳光下尽情地舒展，细小的枝条对未来充满好奇和期待。现在，父亲拖着瘦弱的身子，要以一种近乎残忍的方式介入一棵他亲自栽植的苹果树的命运。\n⑤斧头落下去，父亲听到了树皮破裂的声音——虽然这种声音比斧子撞击树干的声音要小很多，却还是被父亲敏感地捕捉到了。父亲落泪了。\n⑥这几年，这棵苹果树一半枯死，一半硬撑着活了下来，结出的果子像山林里的野果子，酸涩难入口。可父亲心里明白，它为改善我们一家人的生活付出了毕生心血，足以让我们感恩并铭记于心。\n⑦上世纪80年代，父亲和大多数李家山的村民一样，刚刚吃饱肚子，从没有去设想未来。作为木匠的父亲，将大把大把的时间用在了修房子上。在他栽下第一批苹果树苗的时候，大片的小麦仍然享有辽阔的土地，是地里的主角。为了保住小麦，人们曾与草作战，把它们统统赶出麦田。在田里，草都不让长，怎么会容忍树长进去？\n⑧父亲是在乡村干部的劝说下，才栽下了第一片果树。\n⑨果树选择种在院子附近，不是为了管理上的方便，也不是为了看着这些小树苗像孩子一样一天天长大，从而让人感到快乐，父亲是为了看着它们被兔子和羊啃了，被风吹死，被小麦挤赶出去。他在耕地的时候，故意赶着毛驴逼近树苗，让犁铧伤到树根。\n⑩尽管如此，仍然有一些倔强的苹果树活了下来，一副要长大成材的样子，父亲妥协了。为此，父亲的果树也在年轮里写下了新的愿景：为人们奉献甘甜的果肉。\n⑪到第八个年头，父亲果园里的苹果树开始挂果了。父亲开启了新的生活方式，浑身上下充满了力量，进入了一种持续的兴奋状态。按照时序，他在果园里浇水、施肥、疏花、疏果、套袋、摘袋，然后出售苹果，收入一年比一年高，日子也突飞猛进地好了起来。\n⑫带着清香的木屑喷溅而出，落在父亲的身上，像是一棵树要对父亲说出的话语。这个年近80岁的老人，挥动几下笨重的斧子，就开始气喘吁吁。他不得不停下来。越进入树干的内部，就越接近远去的时光，父亲难过极了。这棵苹果树勉强支撑着身体，父亲用力推了一下，苹果树开始吱嘎作响，慢慢倒下。没有大树倒下的那种轰然响动，它只是轻轻地躺在了自己生活过的这块土地上。\n⑬父亲坐在放倒的这棵苹果树身上，抽了一根烟，像是在进行一次长时间的告别仪式。他将用近一个月的时间，砍倒果园里所有的老树，再把它们劈成木柴。这些带着浓郁芳香的木柴，将陪伴他度过一个漫长而寒冷的冬天。\n⑭父亲不再主持果园里的事，只是在天气好的时候，到果园里转转。砍掉了老树的土地，平整而安详，像是卸下了所有的负担，在休憩，在安睡。父亲知道，过上两年，又一批新树苗将在这里郁郁葱葱地长起来。这看似贫瘠的土地。总是会在春秋轮回之间，给劳作的人们以希望和馈赠。\n（选自《光明日报》，有删改）\n（1）请用词语概括父亲对苹果树的感情变化。\n抗拒——（①　　　 ）——（②　　　 ）——难过\n（2）请从修辞的角度赏析文中画线句子。\n带着清香的木屑喷溅而出，落在父亲的身上，像是一棵树要对父亲说出的话语。\n（3）结合本文谈谈你在父亲身上发现的美好品质。\n（4）本文在记叙顺序上有什么特点？请结合具体内容分析其作用。\n（5）本文与八年级上册课文《背影》都塑造了令人印象深刻的父亲形象。请比较两篇文章里在塑造父亲形象时，写作手法上有什么相同之处？结合具体内容简要分析。","incq_64566493a9e6808b31f22551","7．根据《红星照耀中国》和《红岩》的相关内容，完成下面的探究任务。\n（1）在《红星照耀中国》《红岩》中，众多红色人物在思想性格、精神品质上展现了多面性，下面选项中人物与描述不匹配的一项是（ 　　　 ）\nA徐海东：脾气暴躁且言行敏捷：湖南饥荒，有大地主高价卖米，他带领农民攻打地主家，运走存粮；斯诺和他骑马时，突然喊出“冲到顶上去！”的挑战。\nB贺龙：同情穷人且很谦虚：国民党军阀处决大批工人、农民，使其毅然投向共产党；他总是希望别人提出批评，留心听取意见。\nC江姐：细致周全且意志如铁：她被捕前从容处理联络信物，面对酷刑不屈服。\nD许云峰：机警老练且大义凛然：他在沙坪坝书店识破陷阱；在茶园主动起身掩护李敬原，让其安全脱身。\nA.AB.BC.CD.D\n（2）小石认为：茅盾笔下的白杨树能让人联想到《红岩》中的革命英雄。请结合资料卡，从下列名著人物中任选一个，用相关的故事情节来分析其人物形象。\n①小萝卜头    ②成岗    ③江姐\n资料卡\n……这是虽在北方风雪的压迫下却保持着倔强挺立的一种树……这就是白杨树，西北极普遍的一种树，然而决不是平凡的树！\n（节选自茅盾《白杨礼赞》）","incq_c466946dbc761326f777e324","8．阅读下面文字，根据要求写作。\n同学们，站在2026年的门槛回望，在2025这一年里，总有一个词，像一颗特别的星星，在你的成长天空中最闪亮。它可能是你付出的汗水、收获的感悟、克服的挑战，或是一个深深影响你的人。\n这个“关键词”，可以是一种品格（如“坚持”“勇敢”），一份情感（如“温暖”“感谢”），一次突破（如“第一次”“蜕变”），一种热爱（如“围棋”“阅读”），甚至一句对你有特殊意义的话（如“没关系”“看我的”）……\n请以《　　　，2025我的关键词》为题，写一篇不少于600字的文章。\n要求：①补全题目；②内容健康积极：③表达真情实感；④不得套写、抄袭；⑤除诗歌外，文体不限；⑥不要出现真实的地名、校名和人名。","inco_7fff847866c5ed89cef98c61","work_445b585bee442eaa81aec781","inco_f9152c43b6470c245f6f7c9d","work_f9152c43b6470c245f6f7c9d","inco_eefc8dc49599201140dc33ae","work_2ef34aece921a1c8432ad81b","inco_188141b0eaaab75c1eac8dfb","work_188141b0eaaab75c1eac8dfb","work_d36fbf60e000995f7336d5f8","inco_5668074796c1e16846556909","work_5668074796c1e16846556909","work_9b5b26dace5d626a01141c41","work_5830535e824cb813307a0f08","inci_c6deab648277d820e6a9614e","inci_fd577380c386a1f37b1165cc","inci_13e73b4f1b0f61ac1a2e4681","继承正式基线既有篇目身份；本轮不以字符串相似度重新归并历史异文","卷内题名、署名及选段与同期本册古诗文目录对照；不是该册教材篇目"]}