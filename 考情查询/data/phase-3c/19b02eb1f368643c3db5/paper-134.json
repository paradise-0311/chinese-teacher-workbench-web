_ids":[{"$kq":20}],"formal_question_numbers":[],"body_status":"整本书考查","source_path":{"$kq":3},"source_anchor":"[[118, 133]]","source_record_ids":[],"exam_modes":[],"warnings":[],"batch":"20261113_指定学校往年试卷补录","paired_ids":[],"in_class":null,"author_source":null,"themes_verified":false}],[1287,{"id":"inco_be894535deb94cb5030e5419","paper_id":"八上|24-43G-M","work_id":{"$kq":37},"work_identity":{"$kq":37},"title":"经典常谈","formal_reading":false,"basis":["整本书考查"],"identity_basis":"以试卷篇名、署名、正文或出处为依据","blocks":["名著阅读"],"genres":["整本书"],"themes":[],"question_ids":[{"$kq":22}],"formal_question_numbers":[],"body_status":"整本书考查","source_path":{"$kq":3},"source_anchor":"[[133, 139]]","source_record_ids":[],"exam_modes":[],"warnings":[],"batch":"20261113_指定学校往年试卷补录","paired_ids":[],"in_class":null,"author_source":null,"themes_verified":false}]],"answers":[[2286,{"id":{"$kq":2},"question_id":{"$kq":0},"text":"1．答案：\n（1）五色交辉　青林翠竹（注意“辉”的书写）\n（2）绿叶发华滋（注意“华”的书写）\n（3）树树皆秋色\n（4）横柯上蔽　疏条交映（注意“蔽”的书写）\n（5）庭下如积水空明　水中藻、荇交横　盖竹柏影也","status":"已挂接来源参考答案","official":false,"coverage":"available","provenance_kind":{"$kq":38},"source_path":{"$kq":39},"source_anchor":"docx:paragraphs[3:9]","source_sha256":{"$kq":40},"batch":"20261113_指定学校往年试卷补录","limitations":"按题组挂接参考答案。"}],[2287,{"id":{"$kq":7},"question_id":{"$kq":5},"text":"2.答案：\n（1）chuò　由衷　劳碌　huì　qiáo　屏息敛声\n（2）A\n【解答】\n（1）不辍（bù chuò）：不停止，继续不断。\n由衷（yóu zhōng）：出于内心。\n劳碌（láo lù）：辛劳忙碌。\n教诲（jiào huì）：教导训诫。\n翘首（qiáo shǒu）：抬起头来向远处看。\n屏息敛声（bǐng xī liǎn shēng）：抑制语声和呼吸。\n（2）抑扬顿挫：形容声音高低起伏，和谐而有节奏。此处用来形容主持人的声音高低起伏，和谐而有节奏。使用正确。\n振聋发聩：响声很大，使聋人都能听见，比喻用语言文字唤醒糊涂麻木的人，使他们清醒过来。此处用来形容让人欣赏的乐曲，使用不当。\n故选：A。","status":"已挂接来源参考答案","official":false,"coverage":"available","provenance_kind":{"$kq":38},"source_path":{"$kq":39},"source_anchor":"docx:paragraphs[9:22]","source_sha256":{"$kq":40},"batch":"20261113_指定学校往年试卷补录","limitations":"按题组挂接参考答案。"}],[2288,{"id":{"$kq":10},"question_id":{"$kq":8},"text":"3.答案：\n（1）示例：教育部通知要求在义务教育阶段加强书法教育。\n（2）①“通过”或者“使”②充满　充分\n（3）示例：对于七年级到九年级这个年龄段的学生来说，他们的认知水平和艺术素养有限，您会通过哪些独特的方式引导他们深入理解书法作品的内涵、章法、结构和笔法呢？","status":"已挂接来源参考答案","official":false,"coverage":"available","provenance_kind":{"$kq":38},"source_path":{"$kq":39},"source_anchor":"docx:paragraphs[22:26]","source_sha256":{"$kq":40},"batch":"20261113_指定学校往年试卷补录","limitations":"按题组挂接参考答案。"}],[2289,{"id":{"$kq":13},"question_id":{"$kq":11},"text":"4. 答案：\n（1）早春（或“初春”）　暮春（或“晚春”“季春”）\n（2）“几处”“谁家”照应“早莺”“新燕”，说明早莺尚少，新燕不多，表达了钱塘湖初春季节的特点和作者的欣喜之情。如果改为“处处”“家家”，就没有这种表达效果。\n（3）喜爱钱塘湖春天的美景；爱（最爱）\n（4）C","status":"已挂接来源参考答案","official":false,"coverage":"available","provenance_kind":{"$kq":38},"source_path":{"$kq":39},"source_anchor":"docx:paragraphs[26:31]","source_sha256":{"$kq":40},"batch":"20261113_指定学校往年试卷补录","limitations":"按题组挂接参考答案。"}],[2290,{"id":{"$kq":16},"question_id":{"$kq":14},"text":"5.答案：\n（1）①断绝、消失②到达③向上攀登④白天\n（2）D\n（3）①水清，树荣，山高，草盛，实在有很多趣味。\n②青翠的树林和碧绿的小竹子，倒着生长在石壁间。\n（4）侧面描写\n（5）对自然山水的热爱\n【参考译文】\n从雷江口出行进入长江。江南的群山，林木苍绿，山峦重叠，好像一列屏障。总共行驶数十里连绵的景象没有中断。从金陵向西，都未曾看到这样的景象。这一天，顺着风张起风帆，船行得非常快。然而江面水面辽阔，白色的浪花像山一样涌来。所乘坐的虽是载重两千斛的大船，在江面上的摇晃和舞动，好像是一片树叶。过了狮子矶，有一座山名叫佛指矶，长满苔藓的峭壁有百尺高。青色的树林和绿色的竹子，倒挂在石壁上，这种景象是图画也难以描绘的。很遗憾船行驶在北岸，不能穿过山下。旁边还有几个小石矶，也都很奇特陡峭，然而都比不上狮子矶。到了马当山，这里正有所说的长江上水神庙。这里山势尤其俊秀挺拔，正面山脚直插入长江。水神庙依靠着悬崖峭壁架空而建为楼阁。登或下的人都要走楼阁西边悬崖旁的小石径。攀援葛藤侧着脚向上，好像登梯子……船行在石壁之下，白天忽然变得晦暗，风很大，船上的人非常惊恐，变了脸色。急忙放下风帆，赶快驶向港湾，用尽力气牵拉船，船才能泊进港湾。","status":"已挂接来源参考答案","official":false,"coverage":"available","provenance_kind":{"$kq":38},"source_path":{"$kq":39},"source_anchor":"docx:paragraphs[31:40]","source_sha256":{"$kq":40},"batch":"20261113_指定学校往年试卷补录","limitations":"按题组挂接参考答案。"}],[2291,{"id":{"$kq":19},"question_id":{"$kq":17},"text":"6. 答案：\n（1）①“我”旁听陈寅恪先生授课；②推荐我到北大任教；③不肯接受胡适之先生的资助。\n（2）2.运用比喻的修辞手法，形象生动地表现了陈寅恪先生讲课时的细致入微、层层深入，体现了陈寅恪先生学识渊博，授课水平高，表达作者崇敬之情。\n（3）①从侧面体现了先生的渊博学识和高风亮节；②表现了陈寅恪先生在学术和人品方面对我的影响之深；③表达了作者对陈先生的怀念和崇敬之情；④增强文章的真实性。\n（4）学识渊博；治学严谨、认真，实事求是；为人朴素无华，不张扬；心胸宽广，不记人过；关心政治，以天下为己任；热忱爱护帮助青年学者。\n（5）本文语言特点是情感真挚、富有文采。第⑦段中，作者用“世事如白云苍狗，变幻莫测”形象地表达了对世事无常的感慨，运用比喻手法增强了语言的生动性。句中“哲人其萎，空余著述”表达了对陈寅恪先生的深切怀念，语言凝练而富有深意。整体上，作者通过简洁而富有表现力的语言，传达了对陈寅恪先生的敬仰与怀念之情。","status":"已挂接来源参考答案","official":false,"coverage":"available","provenance_kind":{"$kq":38},"source_path":{"$kq":39},"source_anchor":"docx:paragraphs[40:46]","source_sha256":{"$kq":40},"batch":"20261113_指定学校往年试卷补录","limitations":"按题组挂接参考答案。"}]],"exam_items":[[3315,{"id":{"$kq":41},"paper_id":"八上|24-43G-M","number":"1","number_key":"1","question_ids":[{"$kq":0}],"block":"名句默写","type":"古诗文默写","ability":null,"theme":null,"genre":null,"question_text":{"$kq":1},"answer":null,"score":9,"group_score":9,"score_group_key":"1","type_eligible":true,"theme_eligible":false,"source":{"batch_id":"20261113_指定学校往年试卷补录","paper_id":"八上|24-43G-M","path":{"$kq":3},"sha256":{"$kq":4},"anchor":"docx:paragraphs[8:12]"},"status":"按原题任务核对","batch":"20261113_指定学校往年试卷补录"}],[3316,{"id":{"$kq":42},"paper_id":"八上|24-43G-M","number":"2","number_key":"2","question_ids":[{"$kq":5}],"block":"基础积累与语言运用","type":"字音字形","ability":null,"theme":null,"genre":null,"question_text":{"$kq":6},"answer":null,"score":8,"group_score":8,"score_group_key":"2","type_eligible":true,"theme_eligible":false,"source":{"batch_id":"20261113_指定学校往年试卷补录","paper_id":"八上|24-43G-M","path":{"$kq":3},"sha256":{"$kq":4},"anchor":"docx:paragraphs[13:24]"},"status":"按原题任务核对","batch":"20261113_指定学校往年试卷补录"}],[3317,{"id":{"$kq":43},"paper_id":"八上|24-43G-M","number":"3","number_key":"3","question_ids":[{"$kq":8}],"block":"基础积累与语言运用","type":"拟写与仿写","ability":null,"theme":null,"genre":null,"question_text":{"$kq":9},"answer":null,"score":6,"group_score":6,"score_group_key":"3","type_eligible":true,"theme_eligible":false,"source":{"batch_id":"20261113_指定学校往年试卷补录","paper_id":"八上|24-43G-M","path":{"$kq":3},"sha256":{"$kq":4},"anchor":"docx:paragraphs[25:36]"},"status":"按原题任务核对","batch":"20261113_指定学校往年试卷补录"}],[3318,{"id":"inci_9d84eb1398694e388926ef18","paper_id":"八上|24-43G-M","number":"4","number_key":"4","question_ids":[{"$kq":11}],"block":"古诗词","type":null,"ability":null,"theme":null,"genre":"古诗词"