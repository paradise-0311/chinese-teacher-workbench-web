bers":["6","7","8","9"],"source_record_ids":[],"body_status":"full_material","source_path":{"$kq":4},"source_anchor":"[[61, 64]]","exam_modes":[],"warnings":[],"batch":"20261107_九中八上期中","paired_ids":[{"$kq":57}],"in_class":null,"author_source":"唐顺之"}],[1214,{"id":{"$kq":61},"paper_id":"八上|26-09-M","work_id":{"$kq":62},"work_identity":{"$kq":62},"title":"父爱之舟","formal_reading":true,"basis":["本批原卷/校订稿直接阅读题组已核"],"blocks":["现代文阅读"],"genres":["文学类阅读"],"themes":[],"question_ids":[{"$kq":29},{"$kq":33},{"$kq":35},{"$kq":38}],"formal_question_numbers":["10","11","12","13"],"source_record_ids":[],"body_status":"full_material","source_path":{"$kq":4},"source_anchor":"[[98, 113]]","exam_modes":[],"warnings":[],"batch":"20261107_九中八上期中","paired_ids":[],"in_class":null,"author_source":"吴冠中"}]],"answers":[[2052,{"id":{"$kq":2},"question_id":{"$kq":0},"text":"1．（1）jiào huì，dān。\n（2）初衷，彰显。\n（3）白手起家。\n（4）示例　学校开展“人无信不立”主题活动","status":{"$kq":3},"provenance_kind":{"$kq":3},"official":false,"coverage":"available","limitations":"","source_path":{"$kq":63},"source_anchor":"docx:paragraphs[3:7]","source_sha256":{"$kq":64},"batch":"20261107_九中八上期中"}],[2053,{"id":{"$kq":8},"question_id":{"$kq":6},"text":"2．（1）B。“道不同，不相为谋”强调志趣不同的人难以共事，偏离“信”的议题。\n（2）③不向陌生人透露自己的身份证和银行卡信息。④不向陌生人的账户打款或转账。\n（3）示例　小冀，即使没有手机和银行卡，骗子也可能从你这里套取家人的信息。去听讲座可以学会识别骗局，还能提醒家人做好防范。我们一起去听吧！","status":{"$kq":3},"provenance_kind":{"$kq":3},"official":false,"coverage":"available","limitations":"","source_path":{"$kq":63},"source_anchor":"docx:paragraphs[7:10]","source_sha256":{"$kq":64},"batch":"20261107_九中八上期中"}],[2054,{"id":{"$kq":11},"question_id":{"$kq":9},"text":"3．①谁家新燕啄春泥。\n②山山唯落晖。\n③大漠孤烟直，长河落日圆。\n④晴川历历汉阳树，芳草萋萋鹦鹉洲。\n⑤白云千载空悠悠。\n⑥望峰息心。\n⑦窥谷忘反。","status":"据原文、固定诗文或文言语义整理（非学校官方答案）","provenance_kind":"据原文、固定诗文或文言语义整理（非学校官方答案）","official":false,"coverage":"available","limitations":"","source_path":{"$kq":63},"source_anchor":"docx:paragraphs[10:17]","source_sha256":{"$kq":64},"batch":"20261107_九中八上期中"}],[2055,{"id":{"$kq":15},"question_id":{"$kq":12},"text":"4．B。颔联用“随”字让静止的山岭显出动感，属于化静为动。","status":{"$kq":3},"provenance_kind":{"$kq":3},"official":false,"coverage":"available","limitations":"","source_path":{"$kq":63},"source_anchor":"docx:paragraphs[18:19]","source_sha256":{"$kq":64},"batch":"20261107_九中八上期中"}],[2056,{"id":{"$kq":18},"question_id":{"$kq":16},"text":"5．甲诗借故乡水送行，表达对故乡的眷恋与惜别。乙诗以楚狂接舆自比，表达初入楚地的兴奋、豪迈。","status":{"$kq":3},"provenance_kind":{"$kq":3},"official":false,"coverage":"available","limitations":"","source_path":{"$kq":63},"source_anchor":"docx:paragraphs[19:20]","source_sha256":{"$kq":64},"batch":"20261107_九中八上期中"}],[2057,{"id":{"$kq":22},"question_id":{"$kq":19},"text":"6．（1）只是。（2）更加。（3）把……当作柴烧。（4）③。","status":"据原文、固定诗文或文言语义整理（非学校官方答案）","provenance_kind":"据原文、固定诗文或文言语义整理（非学校官方答案）","official":false,"coverage":"available","limitations":"","source_path":{"$kq":63},"source_anchor":"docx:paragraphs[20:22]","source_sha256":{"$kq":64},"batch":"20261107_九中八上期中"}],[2058,{"id":{"$kq":25},"question_id":{"$kq":23},"text":"7．（1）庭院里像积满了澄澈透明的水，水中藻、荇交错纵横，原来是竹子和柏树的影子。\n（2）可是有竹子长在园子里，有的人就把它铲除掉。","status":"据原文、固定诗文或文言语义整理（非学校官方答案）","provenance_kind":"据原文、固定诗文或文言语义整理（非学校官方答案）","official":false,"coverage":"available","limitations":"","source_path":{"$kq":63},"source_anchor":"docx:paragraphs[22:24]","source_sha256":{"$kq":64},"batch":"20261107_九中八上期中"}],[2059,{"id":{"$kq":32},"question_id":{"$kq":29},"text":"10．①父亲借小渔船送“我”离乡投考和上学。\n②父亲和姑爹摇船送“我”去无锡投考师范。\n③父亲摇船送“我”去无锡师范入学，途中为“我”缝补棉被。","status":"据原文、固定诗文或文言语义整理（非学校官方答案）","provenance_kind":"据原文、固定诗文或文言语义整理（非学校官方答案）","official":false,"coverage":"available","limitations":"","source_path":{"$kq":63},"source_anchor":"docx:paragraphs[28:31]","source_sha256":{"$kq":64},"batch":"20261107_九中八上期中"}],[2060,{"id":{"$kq":37},"question_id":{"$kq":35},"text":"12．示例选①。“新滋味”包含离家求学时与亲人分别的心酸，也写出了“我”体会到家人凑钱供自己读书的艰难，对家人的付出心怀感激，开始懂得自己肩负着家人的期待。","status":{"$kq":3},"provenance_kind":{"$kq":3},"official":false,"coverage":"available","limitations":"","source_path":{"$kq":63},"source_anchor":"docx:paragraphs[33:34]","source_sha256":{"$kq":64},"batch":"20261107_九中八上期中"}],[2061,{"id":{"$kq":40},"question_id":{"$kq":38},"text":"13．（1）③考取无锡师范。⑤接触杭州艺专，爱上美术，选择走艺术道路。\n（2）","status":"据原文、固定诗文或文言语义整理（非学校官方答案）","provenance_kind":"据原文、固定诗文或文言语义整理（非学校官方答案）","official":false,"coverage":"partial","limitations":{"$kq":41},"source_path":{"$kq":63},"source_anchor":"docx:paragraphs[34:37]","source_sha256":{"$kq":64},"batch":"20261107_九中八上期中"}],[2062,{"id":{"$kq":47},"question_id":{"$kq":45},"text":"15．“红星”本指红军帽上的红五角星，象征中国共产党及其领导的革命。“照耀中国”写出革命的影响从西北根据地扩展到全国，寄托了斯诺对中国革命前途的信心。","status":{"$kq":3},"provenance_kind":{"$kq":3},"official":false,"coverage":"available","limitations":"","source_path":{"$kq":63},"source_anchor":"docx:paragraphs[39:40]","source_sha256":{"$kq":64},"batch":"20261107_九中八上期中"}],[2063,{"id":{"$kq":50},"question_id":{"$kq":48},"text":"16．示例　毛泽东怀有改造中国、争取人民解放的理想。他领导秋收起义，在井冈山建立革命根据地，并在长征中参与领导红军突破围追堵截。","status":{"$kq":3},"provenance_kind":{"$kq":3},"official":false,"coverage":"available","limitations":"","source_path":{"$kq":63},"source_anchor":"docx:paragraphs[40:41]","source_sha256":{"$kq":64},"batch":"20261107_九中八上期中"}]],"exam_items":[[3061,{"id":{"$kq":65},"paper_id":"八上|26-09-M","number":"1","number_key":"1","question_ids":[{"$kq":0}],"block":"基础积累与语言运用","type":"新闻｜新闻标题拟写","ability":"综合性学习","theme":null,"genre":null,"task":"学校开展了“人无信不立”的主题活动，小冀拟写了一段开场白，请你帮他补充。（7 分）","question_text":{"$kq":1},"answer":null,"score":7,"group_score":7,"score_group_key":"1","type_eligible":true,"theme_eligible":false,"source":{"batch_id":"20261107_九中八上期中","path":{"$kq":4},"sha256":{"$kq":5},"anchor_scheme":{"$kq":66},"admission":{"$kq":67},"anchor":"docx:paragraphs[3:14]"},"status":"原题定位已核，分类仅采既有明确映射","batch":"20261107_九中八上期中"}],[3062,{"id":{"$kq":68},"paper_id":"八上|26-09-M","number":"2","number_key":"2","question_ids":[{"$kq":6}],"block":"基础积累与语言运用","type":"综合性学习｜活动设计/材料探究","ability":"综合性学习","theme":null,"genre":null,"task":"学校举办“反电信诈骗进校园”的学习活动，请你根据要求完成以下任务。（