s":[],"formal_question_numbers":["17"],"source_record_ids":["w02s03h1g1r396","w02s04h1g1r396","w02s05h1g1r330"],"body_status":"not_extracted","source_path":null,"source_anchor":null,"exam_modes":["reading"],"warnings":[{"$kq":21}],"batch":"baseline","paired_ids":[],"work_id":{"$kq":31}}]],"answers":[[1854,{"id":{"$kq":4},"text":"8.示例: 运用夸张的修辞，归予玉笛人的情态，表现了诗人丰富的想象力和浪漫情怀，抒发了思乡之情。/瞳”\n字写出了夜晚笛声修忽而至又无迹可寻的样子，也照应了\"“谁家\"让人产生无限遐想，勾起游子思乡之苦。/从听\n觉角度来描写景物，写出笠声随春风时隐时现的特点/以声音反衬夜晚的安静，写出诗人此时的百无聊赖、思念\n家乡及亲人的心理。","status":"confirmed","source_path":{"$kq":1},"source_anchor":"ocr:l00315","question_id":{"$kq":3}}],[1855,{"id":{"$kq":6},"text":"9. (1) 擅长,善于 (2) 放下 (3) 全,都 (4) 一会儿，不久","status":"confirmed","source_path":{"$kq":1},"source_anchor":"ocr:l00320","question_id":{"$kq":5}}],[1856,{"id":{"$kq":8},"text":"12.甲文揭示了熟能生巧的道理; 乙文揭示了劳逸结合的道理。\n【乙】楚国有个名叫养由基的人人，擅长射箭，距离柳树百步之远，而射树叶百发百中，左右的人都说好。有个人\n从旁边经过，说:“你擅长射箭，可以教你射和蔽了。 ”养由基说:“大家都说我射的好，您却说可以教我射箭。您\n为何不代共我去射百步之远的柳叶呢? “这个人说:“我不能教您伸直左臂支弓，弯曲右臂开己的技巧。而是想说，\n那种射柳叶的功夫虽然百发百中，但是您不善于休息，一会儿力气用完了，习也拉不正，箭也射不直。有一次射\n箭不中，先前百发百中的功夫也就全部来失了。”","status":"confirmed","source_path":{"$kq":1},"source_anchor":"ocr:l00328","question_id":{"$kq":7}}],[1857,{"id":{"$kq":10},"text":"13. 买花生种子 。” 守花生 吃花生","status":"confirmed","source_path":{"$kq":1},"source_anchor":"ocr:l00336","question_id":{"$kq":9}}],[1858,{"id":{"$kq":14},"text":"14.，运用拟人的修辞手法，冉予花生苗、月色、星斗、青蛙、紧蚁等人的行为和情感，生动形象地描绘出花生苗\n生长环境的和谐美好，表现出作者对花生成长的喜爱与关注，也体现了大自然万物和谐共生的景象。","status":"confirmed","source_path":{"$kq":1},"source_anchor":"ocr:l00337","question_id":{"$kq":13}}],[1859,{"id":{"$kq":16},"text":"15. @懂土地: 知道自家沙质土地适合种花生，清楚士地特性和种植规律。@淳朴、感恩: 想着把收获的花生送\n给医生和儿女. 自己和母亲留一小部分、合执着坚韧: 尽管左腿股骨头坏死、仍跪着收花生 侠有爱心: 阻止母\n亲择走鸟任，给鸟儿留食物。","status":"confirmed","source_path":{"$kq":1},"source_anchor":"ocr:l00339","question_id":{"$kq":15}}],[1860,{"id":{"$kq":18},"text":"16.中\"花生\"是全文线索，贯穿种、守、起、吃花生等情节，使文章脉络清晰。信”跪着起花生\"设置悬念，引发\n读者好奇心,吸引读者阅读。@点明主要人物是父亲。 @点明主要事件，突出父亲起花生的艰难，体现其对土地\n的热受和坚韧品质","status":"confirmed","source_path":{"$kq":1},"source_anchor":"ocr:l00342","question_id":{"$kq":17}}]],"exam_items":[[1025,{"id":"w02s03h1g1r380","paper_id":"七下|M04","number":"1","number_key":"1","record_code":"R00379","question_ids":[],"block":"基础积累与语言运用","type":"字音字形｜字形","ability":null,"theme":null,"genre":null,"task":"字音字形｜字形","question_text":"根据拼音写字、找错别字并修改病句。","answer":null,"group_score":null,"score":null,"source":{"record_id":"w02s03h1g1r380","path":{"$kq":32},"workbook":"七下全卷考情底表_核证修订.xlsx","sheet":"02_全卷小问明细","row":380},"status":"confirmed","field_status":{"原题号":"confirmed","题组分值":"pending","一级模块":"confirmed","二级考点":"confirmed","原题核心":"confirmed"}}],[1026,{"id":"w02s03h1g1r381","paper_id":"七下|M04","number":"2","number_key":"2","record_code":"R00380","question_ids":[],"block":"基础积累与语言运用","type":"古诗文默写","ability":null,"theme":null,"genre":null,"task":"古诗文默写","question_text":"古诗文默写。","answer":null,"group_score":null,"score":null,"source":{"record_id":"w02s03h1g1r381","path":{"$kq":32},"workbook":"七下全卷考情底表_核证修订.xlsx","sheet":"02_全卷小问明细","row":381},"status":"confirmed","field_status":{"原题号":"confirmed","题组分值":"pending","一级模块":"confirmed","二级考点":"confirmed","原题核心":"confirmed"}}],[1027,{"id":"w02s03h1g1r382","paper_id":"七下|M04","number":"3","number_key":"3","record_code":"R00381","question_ids":[],"block":"基础积累与语言运用","type":"文学文化常识","ability":null,"theme":null,"genre":null,"task":"文学文化常识","question_text":"判断文学文化常识。","answer":null,"group_score":null,"score":null,"source":{"record_id":"w02s03h1g1r382","path":{"$kq":32},"workbook":"七下全卷考情底表_核证修订.xlsx","sheet":"02_全卷小问明细","row":382},"status":"confirmed","field_status":{"原题号":"confirmed","题组分值":"pending","一级模块":"confirmed","二级考点":"confirmed","原题核心":"confirmed"}}],[1028,{"id":"w02s03h1g1r383","paper_id":"七下|M04","number":"4","number_key":"4","record_code":"R00382","question_ids":[],"block":"基础积累与语言运用","type":"词语成语","ability":null,"theme":null,"genre":null,"task":"词语成语","question_text":"判断成语使用。","answer":null,"group_score":null,"score":null,"source":{"record_id":"